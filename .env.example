# ---- Supabase --------------------------------------------------------------
# Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key — SERVER-SIDE ONLY. Never expose this to the browser or
# commit it to git. Used only by the weekly-report cron route to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Resend (weekly email report) -----------------------------------------
RESEND_API_KEY=re_your_resend_api_key
# Must be an address on a domain you've verified in Resend, OR the Resend
# sandbox address below while testing (only delivers to your own verified
# Resend account email).
RESEND_FROM_EMAIL="Kyiv 3 Dashboard <reports@yourdomain.com>"

# ---- Cron security ----------------------------------------------------------
# Any long random string. Vercel automatically sends it as
# `Authorization: Bearer <value>` to routes triggered by vercel.json crons
# when this variable is set — see docs/DEPLOYMENT.md.
CRON_SECRET=generate-a-long-random-string

# ---- App --------------------------------------------------------------------
# Public URL of the deployed app (used for the "Open dashboard" link in the
# weekly email). Set this AFTER your first Vercel deploy.
NEXT_PUBLIC_APP_URL=https://kyiv3-workforce.vercel.app
